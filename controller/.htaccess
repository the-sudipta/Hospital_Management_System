RewriteEngine On

# Block direct access to PHP files inside the Controller folder
RewriteCond %{THE_REQUEST} \s/+Controller/[^?]*\.php [NC]
RewriteRule .* /Hospital_Management_System/view/error/403_forbidden_error.php [L,R=302]

# Allow access from View, Model, or AJAX requests
SetEnvIf Referer "https://hospital-management-system.sudiptakumar.com/Hospital_Management_System/view/" ALLOWED
SetEnvIf Referer "https://hospital-management-system.sudiptakumar.com/Hospital_Management_System/controller/" ALLOWED
SetEnvIf Referer "https://hospital-management-system.sudiptakumar.com/Hospital_Management_System/model/" ALLOWED
SetEnvIf Referer "https://hospital-management-system.sudiptakumar.com/Hospital_Management_System/index.php" ALLOWED
SetEnvIf Referer "https://hospital-management-system.sudiptakumar.com/Hospital_Management_System/routes.php" ALLOWED

# Instead of 'Deny from all', use RewriteRule for redirection
RewriteCond %{ENV:ALLOWED} !^$
RewriteRule .* - [L]

# Redirect forbidden users to 403 page
RewriteRule .* /Hospital_Management_System/view/error/403_forbidden_error.php [L,R=302]
