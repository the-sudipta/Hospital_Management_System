RewriteEngine On

# Allow all POST requests (for AJAX/API/Form submissions)
RewriteCond %{REQUEST_METHOD} POST
RewriteRule .* - [L]

# Allow GET/POST requests only if they originate from inside "Hospital_Management_System/"
RewriteCond %{REQUEST_URI} !^/php_projects/Hospital_Management_System/ [NC]
RewriteRule .* //view/error/403_forbidden_error.php [L,R=302]

# Allow requests only from your Hostinger subdomain (for extra security)
RewriteCond %{HTTP_HOST} !^hospital-management-system\.sudiptakumar\.com$ [NC]
RewriteRule .* /view/error/403_forbidden_error.php [L,R=302]

# Allow local server access (localhost)
RewriteCond %{REMOTE_ADDR} ^127\.0\.0\.1$ [OR]
RewriteCond %{REMOTE_ADDR} ^::1$
RewriteRule .* - [L]

# Block direct access to PHP files inside the Controller folder
RewriteCond %{REQUEST_URI} ^/php_projects/Hospital_Management_System/controller/.*\.php$ [NC]
RewriteRule .* /view/error/403_forbidden_error.php [L,R=302]

# Final catch-all rule to block unauthorized access
RewriteRule .* /view/error/403_forbidden_error.php [L,R=302]
